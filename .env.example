# ─── Target ───────────────────────────────────────────────
# Single domain scan (used by docker-compose up)
DOMAIN=example.com

# ─── Performance ──────────────────────────────────────────
THREADS=50
MAX_PARALLEL=3

# ─── Features ─────────────────────────────────────────────
# Run httpx to detect live web services (true/false)
RUN_HTTPX=true

# ─── Notifications (optional) ─────────────────────────────
# Slack or Discord webhook URL
WEBHOOK_URL=

# ─── Subfinder API Keys (optional but finds more results) ──
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
BINARYEDGE_API_KEY=
CHAOS_API_KEY=
